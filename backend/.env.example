# 本机直接运行后端使用 localhost；Docker Compose 中改为 postgres
DATABASE_URL=postgresql+asyncpg://planpilot:password@localhost:5432/planpilot
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_REFRESH_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_REUSE_GRACE_SECONDS=5
# session_authoritative: Redis 故障时以数据库会话状态为准；fail_closed: 返回 503
AUTH_REDIS_FAILURE_POLICY=session_authoritative
AUTH_COOKIE_SAMESITE=lax
# 本地 HTTP 开发为 false；生产必须为 true（未设置时由 ENVIRONMENT 自动推导）
AUTH_COOKIE_SECURE=false

# 普通对话模型（可选；未配置时回退到 SmartAI）
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 可选本地模型；Docker 用户同时在项目根目录 .env 中设置
# PLANPILOT_LOCAL_LLM_URL=http://host.docker.internal:8080/v1
MODEL_NAME=
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_TIMEOUT_SECONDS=30
LOCAL_MODEL_FAILURE_THRESHOLD=2
LOCAL_MODEL_CIRCUIT_COOLDOWN_SECONDS=60
LOCAL_MODEL_MAX_CONCURRENCY=1
LOCAL_MODEL_QUEUE_TIMEOUT_SECONDS=2

# DeepSeek / OpenAI 兼容推理接口
SMART_API_KEY=
SMART_BASE_URL=https://api.deepseek.com/v1
# 日常规划、任务生成、普通验收出题：低延迟模型
SMART_MODEL_NAME=deepseek-v4-flash
# 重规划、验收评分等高价值判断：高质量模型
SMART_PRO_MODEL_NAME=deepseek-v4-pro
# 云端服务可以是任意 OpenAI-compatible 接口，不限于 DeepSeek
CLOUD_ROUTINE_TIMEOUT_SECONDS=60
CLOUD_PRO_TIMEOUT_SECONDS=300
CLOUD_MODEL_MAX_RETRIES=0
CLOUD_ROUTINE_MAX_CONCURRENCY=4
CLOUD_PRO_MAX_CONCURRENCY=1
CLOUD_MODEL_QUEUE_TIMEOUT_SECONDS=5
MODEL_GATEWAY_MAX_RETRIES=1
MODEL_GATEWAY_FAILURE_THRESHOLD=3
MODEL_GATEWAY_CIRCUIT_COOLDOWN_SECONDS=60
MODEL_GATEWAY_HALF_OPEN_PROBE_SECONDS=15
MODEL_GATEWAY_REDIS_PREFIX=model_gateway
COACH_AGENT_ENABLED=true

# 本机直接运行后端使用 localhost；Docker Compose 会覆盖为 host.docker.internal
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_NAME=qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=1
EMBEDDING_MAX_CONCURRENCY=1

REDIS_URL=redis://localhost:6379/0
TAVILY_API_KEY=

# SMTP 邮件通知（可选）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=xxxxxx
SMTP_FROM_NAME=PlanPilot
FRONTEND_URL=http://localhost:3000

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Object storage. Use local for a single-node developer setup; production uses
# any S3-compatible service (MinIO, AWS S3, Cloudflare R2, etc.).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_S3_BUCKET=planpilot
STORAGE_S3_ENDPOINT_URL=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=planpilot
STORAGE_S3_SECRET_KEY=replace-with-a-long-random-secret
STORAGE_S3_SECURE=false
# AWS S3 可设为 AES256；MinIO 仅在已配置 KMS 时设置，否则依赖加密磁盘。
STORAGE_S3_SERVER_SIDE_ENCRYPTION=

# FFmpeg preview jobs. Media is streamed to storage; this limit does not load
# the complete upload into API memory.
MEDIA_PREVIEW_TIMEOUT_SECONDS=600
MEDIA_PREVIEW_MAX_UPLOAD_BYTES=524288000

# Leave empty to disable export. Example: http://otel-collector:4318
OTEL_SERVICE_NAME=planpilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=0.1
LEARNING_EVENT_RETENTION_DAYS=730
PREDICTION_RETENTION_DAYS=730
AGENT_OBSERVABILITY_RETENTION_DAYS=365
DATA_QUALITY_RETENTION_DAYS=730
EXPORT_AUDIT_RETENTION_DAYS=1095
EXPIRED_SESSION_RETENTION_DAYS=30
# Beta readiness evidence (Beta remains disabled by default)
BETA_RUNTIME_GATE_TTL_HOURS=24
BETA_SAFETY_OBSERVATION_TTL_HOURS=6
BETA_SAFETY_SCAN_LOOKBACK_HOURS=24
BETA_REVIEW_SAMPLE_RETENTION_DAYS=90
