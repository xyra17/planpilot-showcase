# 本机直接运行后端使用 localhost；Docker Compose 中改为 postgres
DATABASE_URL=postgresql+asyncpg://planpilot:password@localhost:5432/planpilot
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_DAYS=7

# 普通对话模型（可选；未配置时回退到 SmartAI）
OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=
MODEL_NAME=
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_TIMEOUT_SECONDS=30

# DeepSeek / OpenAI 兼容推理接口
SMART_API_KEY=sk-xxxxxx
SMART_BASE_URL=https://api.deepseek.com/v1
# 日常规划、任务生成、普通验收出题：低延迟模型
SMART_MODEL_NAME=deepseek-v4-flash
# 重规划、验收评分等高价值判断：高质量模型
SMART_PRO_MODEL_NAME=deepseek-v4-pro

# 本机直接运行后端使用 localhost；Docker Compose 会覆盖为 host.docker.internal
EMBEDDING_API_KEY=local
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL_NAME=qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024

REDIS_URL=redis://localhost:6379/0
TAVILY_API_KEY=tvly-xxxxxx

# SMTP 邮件通知（可选）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=xxxxxx
SMTP_FROM_NAME=PlanPilot

SENTRY_DSN=https://xxxxxx@example.ingest.sentry.io/xxxxxx
