                "break_time",
                "buffer_ratio"
            ],
            "type": "json_keys"
        }
    },
    {
        "category": "structured",
        "id": "json-107",
        "prompt": "为「React Hooks 入门」生成一个学习任务JSON对象，要求包含task_title、estimated_days、key_concepts、acceptance_criteria字段，task_title必须是字符串类型，只输出一个JSON对象，禁止输出数组。",
