    {
        "category": "structured",
        "id": "json-101",
        "prompt": "我下周要备考计算机二级MS Office，请帮我生成单个学习任务的JSON对象，包含title、duration_minutes、difficulty、resources字段，只输出一个JSON对象，禁止输出数组。",
        "validator": {
            "keys": [
                "title",
                "duration_minutes",
                "difficulty",
                "resources"
            ],
            "type": "json_keys"
        }
    },
    {
        "category": "structured",
        "id": "json-102",
        "prompt": "请生成一个为期两周的考研英语起步阶段计划，输出为一个JSON对象，必须包含plan_name、start_date、end_date、phases、overall_goal字段；phases只包含2个简短阶段，每阶段最多2项任务。只输出一个JSON对象，禁止输出数组。",
        "validator": {
            "keys": [
                "plan_name",
                "start_date",
                "end_date",
                "phases",
                "overall_goal"
            ],
            "type": "json_keys"
        }
    },
    {
        "category": "structured",
        "id": "json-103",
        "prompt": "今天完成了高等数学第三章的复习题，请帮我生成一个打卡反馈JSON对象，包含task_id、completed、actual_minutes、mood、note字段，只输出一个JSON对象，禁止输出数组。",
        "validator": {
            "keys": [
                "task_id",
                "completed",
                "actual_minutes",
                "mood",
                "note"
            ],
            "type": "json_keys"
        }
    },
    {
        "category": "structured",
        "id": "json-104",
        "prompt": "请针对SQL的JOIN知识点出一道验收题，输出为一个JSON对象，必须包含question、options、answer、explanation字段，只输出一个JSON对象，禁止输出数组。",
        "validator": {
            "keys": [
                "question",
                "options",
                "answer",
                "explanation"
            ],
            "type": "json_keys"
        }
    },
    {
        "category": "structured",
        "id": "json-105",
        "prompt": "我最近总是学一会就犯困，请给我生成一个学习建议JSON对象，包含issue、suggestion、expected_effect、priority字段，只输出一个JSON对象，禁止输出数组。",
        "validator": {
            "keys": [
                "issue",
                "suggestion",
                "expected_effect",
                "priority"
            ],
            "type": "json_keys"
        }
    },
    {
        "category": "structured",
        "id": "json-106",
        "prompt": "请帮我生成一个学习时间预算JSON对象，包含total_hours、daily_average、break_time、buffer_ratio字段，只输出一个JSON对象，禁止输出数组。",
