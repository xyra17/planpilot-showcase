    {
        "category": "instruction",
        "id": "constraint-101",
        "prompt": "用中文一句话（不超过20字）回答：常用于分类任务的激活函数是什么？不要给出任何解释。",
        "validator": {
            "type": "max_chars",
            "value": 20
        }
    },
    {
        "category": "instruction",
        "id": "constraint-102",
        "prompt": "这是固定格式服从测试，请在以下三个选项中选择B，只输出选项字母，禁止任何解释：A.复习 B.练习 C.休息",
        "validator": {
            "type": "one_of",
            "values": [
                "B"
            ]
        }
    },
    {
        "category": "instruction",
        "id": "constraint-103",
        "prompt": "请用纯Markdown格式回答，第一行是二级标题「## 我的本周计划」，第二行是无序列表项「- 学习目标」，不要输出代码块、不要输出任何解释。",
        "validator": {
            "type": "regex",
            "value": "^## 我的本周计划\\n- 学习目标$"
        }
    },
    {
        "category": "instruction",
        "id": "constraint-104",
        "prompt": "请输出二分类中常用的二元交叉熵损失英文缩写（3个英文字母），不区分大小写，不要标点、不要解释。",
        "validator": {
            "type": "regex",
            "value": "^[bB][cC][eE]$"
        }
    },
    {
        "category": "instruction",
        "id": "constraint-105",
        "prompt": "请输出一个学习建议，必须同时包含「番茄工作法」「主动回忆」「间隔重复」这三个关键词，可以多说几句，但三者缺一不可。",
        "validator": {
            "type": "contains_all",
            "values": [
                "番茄工作法",
                "主动回忆",
                "间隔重复"
            ]
        }
    },
    {
        "category": "instruction",
        "id": "constraint-106",
        "prompt": "请用不超过15个汉字回答：备考雅思口语最关键的练习方式是什么？不要解释。",
        "validator": {
            "type": "max_chars",
            "value": 15
        }
    },
    {
        "category": "instruction",
        "id": "constraint-107",
        "prompt": "在以下选项中选出「番茄工作法」单次专注时长，只输出数字（分钟），不要单位、不要解释。选项：15、25、45、90",
        "validator": {
            "type": "one_of",
            "values": [
                "25"
            ]
        }
    },
    {
        "category": "instruction",
        "id": "constraint-108",
        "prompt": "请输出一段学习建议，必须同时包含「制定计划」「及时复盘」「适当休息」「主动输出」这四个关键词，四者缺一不可。",
        "validator": {
            "type": "contains_all",
            "values": [
                "制定计划",
                "及时复盘",
                "适当休息",
                "主动输出"
            ]
        }
    },
    {
        "category": "instruction",
        "id": "constraint-109",
        "prompt": "请用中文输出一段学习建议，禁止使用英文单词、禁止使用代码块、不要列表，只输出一段不超过30字的话。",
        "validator": {
            "type": "max_chars",
            "value": 30
        }
    },
    {
        "category": "instruction",
        "id": "constraint-110",
        "prompt": "请按以下固定JSON模板回答（字段值可变，键名必须完全一致，顺序可不同）：{\"start\":\"\",\"end\":\"\",\"break\":\"\"}，只输出这一个JSON对象，不要数组、不要解释、不要Markdown代码围栏。",
        "validator": {
            "type": "json_keys",
            "keys": [
                "start",
                "end",
                "break"
            ]
        }
    },
